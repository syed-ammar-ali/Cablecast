# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"
NEON_BRANCH="production"

# Media APIs
TMDB_API_KEY="your_tmdb_api_key"
YOUTUBE_API_KEY="your_youtube_api_key"
ADMIN_PASSWORD_HASH="your_bcrypt_hash"
MOVIE_WEB_PROXY_URL="http://localhost:3000/api/proxy/movie-web"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:support@cablecast.tv"
CRON_SECRET="your_cron_secret"

# Phone Notifications (Twilio SMS & Voice Calls)
# Sign up at twilio.com (free trial available) to get these credentials:
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_FROM_NUMBER="+12015550123"
